# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# One file, on one VM, for all three deployables. Key material is NOT in here —
# the .pem files are mounted beside it and this file holds their paths.
#
# Every value below differs between the development WhatsApp account and the
# Bank's, or between BankOne staging and production. That is why none of them is
# a constant, and why staging and production differ only by this file.
#
# Rotation is: edit this file, restart the containers.

# --- Everywhere --------------------------------------------------------------
# Which deployment this is. Nothing branches on it — staging and production
# differ only by the values in this file — it is here so a log line and a health
# body can say where they came from. Deliberately not NODE_ENV, which belongs to
# Node and to Next and is forced to `production` inside a container.
DEPLOYMENT_ENVIRONMENT=development  # development | staging | production
LOG_LEVEL=info                      # fatal | error | warn | info | debug | trace

# --- Postgres, the only datastore --------------------------------------------
# Read by the Compose file when it starts the database. This login must OWN the
# database and schema `public` and be able to CREATE ROLE — the migration step
# makes the two roles below and revokes the default PUBLIC privileges. The
# container's own superuser satisfies all of that; a login the Bank's DBA
# provisions by hand needs it stated. See docs/runbook.md.
POSTGRES_USER=avni
POSTGRES_PASSWORD=                  # set this before anything reachable from outside the VM
POSTGRES_DB=avni
POSTGRES_PORT=5432                  # port published on the host

# THREE DIFFERENT LOGINS against one database, not one login wearing three
# names. The Middleware holds the Binding and the hashed Transaction PIN; the
# Platform is the prompt-injection surface and must hold none of it (ADR-0006).
#
# `docker compose run --rm migrate` creates the two roles below, sets their
# passwords from these URLs, and applies the grants: the Middleware reads and
# writes every table and cannot change the schema; the Platform may connect and
# read `schema_migrations`, which is how it knows whether it may start, and
# nothing else. Re-run it after every release, and the grants are re-applied
# over whatever the release's migrations created.
#
# IT REFUSES TO RUN IF ANY TWO OF THESE NAME THE SAME ROLE. Three keys pointing
# at one login are exactly as reachable as one key, and a deployment configured
# that way does not migrate and therefore does not start.
#
# Inside Compose the host is the service name; from the host machine, localhost.
# A password containing @ : / or ? must be percent-encoded — it is a URL.
#
# The owning credential. The migration step reads this and nothing else does.
DATABASE_URL=postgres://avni:@postgres:5432/avni
MIDDLEWARE_DATABASE_URL=postgres://avni_middleware:@postgres:5432/avni
PLATFORM_DATABASE_URL=postgres://avni_platform:@postgres:5432/avni

# =============================================================================
# Middleware — the only component that speaks to BankOne, and the only one that
# holds a credential or a security record (ADR-0002, ADR-0006).
# =============================================================================
MIDDLEWARE_PORT=3001
MIDDLEWARE_PUBLIC_BASE_URL=         # where WhatsApp Flows and Widgets post; must be reachable
                                    # from the public internet, e.g. https://mw.bank.example
PLATFORM_PUBLIC_BASE_URL=           # where a Customer's handset reaches the Platform, and
                                    # therefore where a Snippet pasted into the Bank's mobile
                                    # application fetches the Widget from (ADR-0011). A
                                    # different address from MIDDLEWARE_BASE_URL below, which
                                    # only has to work between containers.

# --- The credential encryption key -------------------------------------------
# What the Middleware seals everything it must be able to read back with: the
# in-app chat signing secrets, and the credential behind every registered
# Connector.
#
# It must NOT live in Postgres beside the ciphertext. A database dump that
# carries its own key is not encrypted, it is obfuscated. 32 bytes of base64:
#
#   openssl rand -base64 32
#
# Losing it means every signing secret has to be re-issued, every Bank backend
# re-configured, and every Connector credential entered again — nothing reads
# one back, so there is nothing to migrate it from. Changing it has the same
# effect, so it is not a value to rotate casually.
CREDENTIAL_ENCRYPTION_KEY=

# --- BankOne -----------------------------------------------------------------
INSTITUTION_API_BASE=               # e.g. https://staging.mybankone.com/BankOneWebAPI
INSTITUTION_API_KEY=                # {AUTH_TOKEN} — the same value for both services
INSTITUTION_CODE=                   # the Bank's BankOne institution code
BANK_CODE=                          # the Bank's own NIBSS code. NOT the example in
                                    # docs/reference/bankone-api.md §2 — that one is 090110,
                                    # which is VFD Microfinance Bank's real code, and it has
                                    # been copied into a live .env once already. Take it from
                                    # the Bank's own bank list. The Middleware checks this
                                    # against that list at boot and refuses to serve if the
                                    # code belongs to a differently-named institution.
BANK_NAME=                          # the Bank's own name, as a Customer says it and as the
                                    # Confirmation screen shows it, e.g. The first deployment's Bank. A transfer
                                    # is routed intra- or inter-bank from whether the bank the
                                    # Customer named is this one.
THIRD_PARTY_API_BASE=               # e.g. https://staging.mybankone.com/thirdpartyapiservice/apiservice
BANKONE_PRODUCT_CODE=               # savings product new accounts open under
BANKONE_OFFICER_CODE=               # account officer new accounts are assigned to

# --- WhatsApp / Meta ---------------------------------------------------------
# Nothing transfers from the Avni account to the Bank's. Every id below is
# WABA-scoped and is different in production.
WHATSAPP_API_URL=                   # e.g. https://graph.facebook.com/v19.0
WHATSAPP_API_TOKEN=                 # Graph API access token
WHATSAPP_VERIFY_TOKEN=              # webhook verification challenge token
WHATSAPP_PHONE_NUMBER_ID=           # the sending number's id on this WABA
WHATSAPP_APP_SECRET=                # OPTIONAL, and leaving it blank turns OFF signature
                                    # verification on the Flows endpoint — the Middleware's one
                                    # inbound path from the public internet, and the surface a
                                    # Transaction PIN is entered on. Meta recommends the check
                                    # and does not require it. With it blank, anything that can
                                    # encrypt to the Flows public key is accepted, so that key
                                    # is the only thing in front of this endpoint. The
                                    # Middleware logs which way it is running at every boot.
                                    # Meta app dashboard -> App Settings -> Basic -> App Secret.

# --- WhatsApp Flows (encrypted endpoint data exchange) -----------------------
# Flows encrypt with RSA key exchange + AES-GCM. The public key is uploaded to
# Meta; the private key stays on the VM as a mounted file and never leaves it.
# This is a PATH. Pasting the key itself here is refused at boot.
WA_FLOW_PRIVATE_KEY_PATH=./secrets/whatsapp-flow-private.pem
WA_FLOW_PASSPHRASE=                 # passphrase protecting that private key
WA_SEND_MONEY_FLOW_ID=              # published "Send Money" Flow id
WA_SET_PIN_FLOW_ID=                 # published "Set Transaction PIN" Flow id
WA_ENROLLMENT_FLOW_ID=              # published "Link your account" Flow id. One Flow
                                    # carries enrollment, renewal and a forgotten-PIN
                                    # reset — same screens, different first step, and
                                    # the Middleware decides which walk a Customer is on.

# --- The Bank's identity API -------------------------------------------------
# Five endpoints the Bank builds to docs/reference/bank-identity-api.md. Their
# service sends the code; the platform never learns a phone number or an email.
# The fifth pages the Bank's own operations desk about a stuck transfer, and is
# the only one on that API not about a Customer.
BANK_IDENTITY_API_BASE=             # e.g. https://identity.bank.example
BANK_IDENTITY_API_KEY=

# The Bank's SIX-digit CBN code, which the NUBAN check digit is computed over.
# A NUBAN is verified against THE bank code, so this is the same code that routes
# a transfer. It stays a separate key only because nothing guarantees an
# institution's CBN and NIBSS codes are the same string; where they agree, set
# both to the same value.
#
# SIX digits, per the 2020 revision that brought Other Financial Institutions
# into NUBAN: a commercial bank's three-digit code left-padded with zeros
# (058 -> 000058), an OFI's five-digit code behind a leading 9. A MICROFINANCE
# BANK IS AN OFI, and the old three-digit form validates nothing such a bank has
# issued — every real Customer told to check their account number, on the first
# enrollment screen, before any call leaves the platform.
#
# Confirm it against a real account number, and see docs/reference/nuban.md:
#   node scripts/solve-nuban-bank-code.mjs <account-number>
NUBAN_BANK_CODE=                    # e.g. 090999

# Keys the decoy destinations shown for an account the Bank does not hold. They
# must be identical on two probes of the same number — anything random is itself
# the oracle — and they must not be computable by anyone who has read the source,
# which is what this value buys. Any long random string. Changing it only changes
# which fabricated numbers an attacker is shown.
ENROLLMENT_DECOY_SECRET=

# Days with no CUSTOMER-INITIATED contact before a Binding goes dormant and
# renewal is required. Messages we send never count — a notification to an
# already-recycled number must not keep alive exactly the Binding this expiry
# exists to kill. 90 is a starting value, not a finding: the real operator churn
# window is worth confirming.
BINDING_DORMANCY_DAYS=90

# --- The audit log -----------------------------------------------------------
# The single record of who did what, written by the Middleware and read by the
# Dashboard. A table rather than a log file, because a table the Dashboard reads
# is reachable from a deployment we do not operate and a file on a box is not.
#
# How long the Bank keeps rows, in days. 0 means forever, and is the default.
# The platform NEVER deletes a row — this records the Bank's policy for their
# own archival tooling rather than enacting it here. A table that prunes its own
# evidence is not evidence.
AUDIT_RETENTION_DAYS=0

# --- Handoff and the Inbox ---------------------------------------------------
# Minutes of Support Officer silence after which their claim on a conversation
# expires and it returns to the queue. Without one, a conversation is held
# hostage by somebody who went home with it open, which is the failure that
# actually happens.
#
# NOTE the two settings that are deliberately NOT here. The Bank's business
# hours and the operations alert address are edited from the Dashboard and live
# in the database: opening hours change without a redeploy, and the address is
# the Bank's to point wherever they actually staff.
HANDOFF_CLAIM_IDLE_MINUTES=30

# The one approved WhatsApp template, which reopens a conversation whose
# 24-hour window shut before an Officer answered — "we have an update about your
# transfer, reply to continue", with the real content held until the Customer
# replies. It must be SUBMITTED TO META FOR APPROVAL, which is lead time. A
# late-resolved Handoff is its only user. In-app chat needs none of this.
WA_REOPEN_TEMPLATE_NAME=             # e.g. support_update_available
WA_REOPEN_TEMPLATE_LANGUAGE=en

# --- The Library -------------------------------------------------------------
# How much of the Bank's own published material the Support Agent may be given
# on ONE TURN, in tokens. The documents themselves are uploaded and published
# from the Dashboard, not from here — v1 ships the surface with no corpus.
#
# THIS IS A CAPACITY CONTROL, NOT A QUALITY KNOB. The binding constraint is not
# the model's 131K context window but Groq's 250K TPM: a Support Agent
# conversation already costs roughly 25,000 cumulative input tokens, and
# anything in the preamble multiplies against every turn of every conversation.
# A 40,000-token policy set stuffed into context would leave the whole Bank
# about six Agent turns a minute.
#
# Prompt caching does NOT relieve this. Groq prices a cached prefix at half, and
# nothing documents cached tokens being discounted against TPM — so caching
# answers the bill, which was never the problem at half a cent a conversation.
# Never size capacity on it.
#
# 8000 is a starting value rather than a finding: it wants a real corpus, and
# asking the Bank for theirs is on the bank-asks list.
LIBRARY_RETRIEVAL_BUDGET_TOKENS=8000

# --- Attachments -------------------------------------------------------------
# Object storage on the Bank's infrastructure. A Customer photographing a
# receipt is ordinary support, and a document handed to the layer running the
# LLM is an injection vector with a file extension — so the Platform moves the
# bytes in WITHOUT OPENING THEM and only the Dashboard reads one back.
#
# The endpoint, bucket and region are shared. THE CREDENTIALS ARE NOT: the
# Platform's key must be write-only at the bucket policy and the Middleware's
# read-only, exactly as the two database URLs are separate. One key used for
# both would make that policy the only thing between the prompt-injection
# surface and a Customer's documents.
ATTACHMENT_STORE_ENDPOINT=http://minio:9000
ATTACHMENT_STORE_BUCKET=avni-attachments
ATTACHMENT_STORE_REGION=us-east-1

# The development object store itself, read by docker-compose.yml rather than by
# any deployable. In production the Bank runs their own and these go unused.
MINIO_ROOT_USER=avni
MINIO_ROOT_PASSWORD=avni-object-store
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# READ AND WRITE on this side, and the asymmetry that matters is unchanged. The
# read serves a Customer's attachment to an Officer; the write stores an
# Administrator's Library upload under library/. A Library document is bytes the
# platform reads ON PURPOSE — the opposite rule to an attachment's, in the same
# bucket under a different prefix — and the Platform's key below is still
# write-only, with a type that has no way to read at all.
MIDDLEWARE_ATTACHMENT_STORE_ACCESS_KEY_ID=
MIDDLEWARE_ATTACHMENT_STORE_SECRET_ACCESS_KEY=

# =============================================================================
# Platform — channels, orchestration and support. Holds no credential and no
# route to BankOne. This is the prompt-injection surface (ADR-0006).
# =============================================================================
PLATFORM_PORT=3002
MIDDLEWARE_BASE_URL=http://middleware:3001   # also read by the Dashboard

# --- WhatsApp, the Platform's half -------------------------------------------
# The Platform receives the webhook and sends ordinary replies, so it reads the
# same four Graph values the Middleware does. It does NOT read WA_FLOW_* — an
# authorisation surface posts to the Middleware and terminates there (ADR-0007),
# so the key that opens one never enters the prompt-injection surface.
#
# (These four keys are shared rather than split, because both deployables
# genuinely send on the same WhatsApp number.)

# --- Groq --------------------------------------------------------------------
# Zero Data Retention is switched on for this account.
# The Bank's own name, and where somebody who does not bank here yet is sent.
# The Platform greets an unknown number before any model call, so it reads both:
# BANK_NAME above is the same value the Middleware reads.
BANK_SIGNUP_URL=                    # e.g. https://bank.example/open-an-account

GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b         # Intent resolution: json_schema, strict, temperature 0
GROQ_SUPPORT_MODEL=openai/gpt-oss-120b       # Support Agent: tool calling, no response_format

# --- Attachments, the Platform's half ----------------------------------------
# WRITE-ONLY against the bucket named above. The Platform puts a Customer's file
# into object storage and holds no credential that could read one back — a
# document inside the prompt-injection surface is the whole thing this split
# exists to prevent.
PLATFORM_ATTACHMENT_STORE_ACCESS_KEY_ID=
PLATFORM_ATTACHMENT_STORE_SECRET_ACCESS_KEY=

# =============================================================================
# Dashboard — the one web application the Bank's staff sign in to.
# =============================================================================
DASHBOARD_PORT=3003
PLATFORM_BASE_URL=http://platform:3002
